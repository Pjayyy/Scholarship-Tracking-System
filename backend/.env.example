# Server Configuration
PORT=5000

# For local development on same machine: localhost or 127.0.0.1 works fine
# For accessing from other devices on network: use your machine's IP address
# To find your IP: ipconfig (Windows) or ifconfig (Mac/Linux)
# Example: http://192.168.1.50:5000

# Database
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=scholarship

# Gmail Configuration (if using announcement ingestion)
# GMAIL_OAUTH_CLIENT_ID=your_client_id
# GMAIL_OAUTH_CLIENT_SECRET=your_client_secret
# GMAIL_REFRESH_TOKEN=your_refresh_token

# Document Intelligence (if using OCR)
# AZURE_KEY=your_key
# AZURE_ENDPOINT=your_endpoint

# MQTT (if using real-time events)
# MQTT_BROKER=mqtt://broker.example.com
# MQTT_PORT=1883
