# Copy to .env (or .env.local) and set values.
# IMPORTANT: After changing, restart the frontend (npm start).

# Single backend URL (legacy)
# REACT_APP_API_URL=http://192.168.1.50:5000

# Multiple backend candidates (recommended for WiFi/IP changes)
# Comma-separated list.
REACT_APP_API_URLS=http://192.168.43.160:5000,http://192.168.1.50:5000

